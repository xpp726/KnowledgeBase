# 复制为 .env 后按需修改，所有值均可从环境变量覆盖

# ==================== 服务 ====================
APP_NAME=KnowledgeBase API
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ==================== 数据库 ====================
# 开发期留空（自动用 sqlite+aiosqlite 指向 data/kb.db）
# 生产部署填 MySQL（与 deploy/docker-compose.yml 的 mysql 服务对应）：
#   mysql+asyncmy://kb:kb_user_pwd_change_me@127.0.0.1:3306/kb
# ⚠️ MySQL 9.x 默认 caching_sha2_password，非 TLS 直连需 cryptography 包（已加入 requirements.txt）
DATABASE_URL=
# 排障时置 true 打印 SQL 语句，默认 false
DB_ECHO=false

# ==================== LLM 抽象层：provider 热切换（qwen / deepseek / deepseek_intra） ====================
# 2026-09-05：内网 221 开发机不可达，开发期用 deepseek；回内网改回 qwen
LLM_PROVIDER=deepseek
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.4

# qwen（内网 vLLM，Qwen3-27B-FP8）
LLM_BASE_URL=http://192.168.124.221:8000/v1
LLM_MODEL=Qwen3.8-27B-FP8
LLM_ENABLE_THINKING=false

# DeepSeek 公网官方 API（开发期调试用，切 LLM_PROVIDER=deepseek 生效）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek 内网自部署（OpenAI 兼容接口，切 LLM_PROVIDER=deepseek_intra 生效）
DEEPSEEK_INTRA_BASE_URL=
DEEPSEEK_INTRA_API_KEY=EMPTY
DEEPSEEK_INTRA_MODEL=deepseek-chat

# ==================== Embedding（本机 Docker 自建 BGE-M3，dense 1024 + sparse） ====================
# 内网 221:8003 的 docmind-embed 已弃用
EMBED_BASE_URL=http://localhost:8003
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
EMBED_BATCH_SIZE=64

# ==================== Milvus（本机 Docker 自建 standalone v2.5.27） ====================
# 内网 221:19530 的 docmind 实例有 372 万向量且状态不健康，勿连
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=kb_chunks
MILVUS_TOP_K=30
MILVUS_RRF_K=60

# ==================== 文件存储（原始文档） ====================
# local（开发期写本地 data/uploads）/ minio（部署期对象存储）
STORAGE_BACKEND=local
# deploy/docker-compose.yml 中已运行 MinIO，业务文件复用同一实例
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kb-files
MINIO_SECURE=false

# ==================== 多知识库 ====================
DEFAULT_KB_NAME=默认知识库
DEFAULT_KB_ID=default

# ==================== 检索与生成 ====================
RERANK_TOP_N=5
# dense 相似度下限，低于则判“知识库无相关内容”不调用 LLM；语料大改后需重新标定
SCORE_THRESHOLD=0.55
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ==================== 并发（5-10 人部门级，单进程） ====================
MAX_CONCURRENT_REQUESTS=3

# ==================== 后台任务 / 状态恢复 ====================
# 文档卡在 pending/ingesting/embedding 超过该秒数，启动时判定为进程中断并标记 failed
STUCK_TIMEOUT_SECONDS=1800

# ==================== 日志持久化 ====================
# 日志目录（相对路径相对 backend 根目录；可用绝对路径覆盖）
LOG_DIR=data/logs
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 按天轮转，保留天数（超期自动删除）
LOG_RETENTION_DAYS=30
